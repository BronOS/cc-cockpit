{
  "name": "cc-cockpit",
  "version": "0.1.1",
  "description": "Desktop cockpit for Claude Code: terminal tabs, session status and plugin panels",
  "license": "MIT",
  "author": "Oleg Bronzov",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:hello && npm run build:browser && electron-vite build",
    "build:hello": "node scripts/build-hello.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "build:example": "node examples/plugin/build.mjs",
    "build:marketplace-tools": "node scripts/build-marketplace-tools.mjs",
    "build:icon": "electron scripts/render-icon.cjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@rjsf/core": "6.11.0",
    "@rjsf/utils": "6.11.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "js-yaml": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
