'use strict'
// The panel page's code: `ccPanel` comes from /__sdk/panel.js (see `ccc guide panels`).
let pings = 0
ccPanel.onMessage((message) => {
  document.getElementById('out').textContent = JSON.stringify(message, null, 2)
})
document.getElementById('ping').addEventListener('click', () => {
  pings += 1
  ccPanel.post({ ping: pings })
})
