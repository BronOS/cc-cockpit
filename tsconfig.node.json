{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/cli/**/*",
    "src/host/**/*",
    "src/sdk/**/*",
    "src/shared/**/*",
    "src/themes/**/*",
    "test/**/*",
    "plugins/hello/src/**/*",
    "examples/plugin/src/**/*",
    "examples/plugin/sdk/**/*",
    "marketplace/tools/src/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["src/sdk/panel.ts"]
}
